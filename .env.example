# Copy to .env.local for `vercel dev`, or set these in Vercel:
# Project > Settings > Environment Variables. Never commit real values.

# Live AI answers. Without it the assistant runs in demo mode.
ANTHROPIC_API_KEY=

# Contact and copyright forms (Supabase table public.site_messages, insert-only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: higher Google Books search limits (works without a key at a lower quota)
GOOGLE_BOOKS_API_KEY=

# Optional overrides
# OMT_AI_MODEL=claude-opus-5-5
# OMT_AI_EFFORT=low            # low | medium | high
# OMT_AI_RATE_LIMIT=20         # requests per visitor per 10 minutes
