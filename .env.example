# Copy to .env for local development with `netlify dev`, or set these in
# Netlify: Site configuration > Environment variables. Never commit real values.

# Required for live AI answers. Without it the assistant runs in demo mode.
ANTHROPIC_API_KEY=

# Optional overrides
# OMT_AI_MODEL=claude-opus-5-5
# OMT_AI_EFFORT=low            # low | medium | high
# OMT_AI_RATE_LIMIT=20         # requests per visitor per 10 minutes
